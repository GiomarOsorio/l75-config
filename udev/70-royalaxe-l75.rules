# ROYALAXE / ProtoArc L75 - access to the configuration interface without root.
# Install:  sudo cp 70-royalaxe-l75.rules /etc/udev/rules.d/
#            sudo udevadm control --reload-rules && sudo udevadm trigger
# Then unplug and reconnect the keyboard.

# Wired keyboard (USB 3151:4015)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="4015", MODE="0660", TAG+="uaccess"

# Rongyuan 2.4 GHz receivers (for future versions of the app)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="4011", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="4014", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="4017", MODE="0660", TAG+="uaccess"

# Bluetooth (BLE): the HID device is named 0005:3151:4012.XXXX
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0005:3151:4012.*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0005:3151:4013.*", MODE="0660", TAG+="uaccess"
